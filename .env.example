# =============================================================================
# turbo-temp — root environment variables
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# For production, set these in your hosting provider (Vercel project settings,
# Railway service env, etc.) — the .env file is git-ignored on purpose.
#
# IMPORTANT: do NOT wrap values in quotes when setting them in Vercel — the
# UI stores quotes literally and your app will receive `"my-secret"` instead
# of `my-secret`. Plain values only.
# =============================================================================


# -------- Database (PostgreSQL) ----------------------------------------------
# DATABASE_URL — pooled connection (pgBouncer). Used by app code at runtime.
# DIRECT_URL   — direct connection (no pooler). Required by Prisma CLI for
#                migrations. Prisma's migration engine needs raw connections.
# On Neon: drop "-pooler" from the host AND remove ?pgbouncer=true&... params
# for DIRECT_URL.
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://user:password@host:5432/dbname"


# -------- Redis (BullMQ) -----------------------------------------------------
# Upstash hands you a rediss:// (TLS) URL — BullMQ supports it natively.
REDIS_URL="redis://localhost:6379"


# -------- NextAuth (TT-118) --------------------------------------------------
# NEXTAUTH_SECRET — used to sign JWT session tokens. Required.
#   Generate with: openssl rand -base64 32
# NEXTAUTH_URL    — only required in production. Locally, leave it to each
#   app's .env.local (apps/app uses :3000, apps/dashboard uses :3001).
# NEXTAUTH_COOKIE_DOMAIN — set this ONLY if you want a single sign-on cookie
#   shared across multiple subdomains (e.g. ".example.com" so app.example.com
#   and dashboard.example.com share the session). Leave blank for single-host
#   setups; the cookie defaults to host-only.
NEXTAUTH_SECRET=
# NEXTAUTH_URL=https://your-app.example.com
# NEXTAUTH_COOKIE_DOMAIN=.example.com


# -------- OAuth providers (TT-118) -------------------------------------------
# Both are optional — sign-in pages gate the buttons on env-var presence so
# you can ship without them. Leave blank to disable that provider entirely.
#
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0
#   Authorized redirect URIs:
#     - http://localhost:3000/api/auth/callback/google     (apps/app dev)
#     - http://localhost:3001/api/auth/callback/google     (apps/dashboard dev)
#     - https://<prod-host>/api/auth/callback/google       (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: github.com/settings/developers → New OAuth App
#   Authorization callback URL: https://<prod-host>/api/auth/callback/github
#   The dashboard app is the canonical GitHub linkage point — the marketing
#   app deliberately doesn't expose GitHub (single-callback-URL constraint).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


# -------- Email (Resend) -----------------------------------------------------
# Used for password-reset emails (TT-118). In dev (NODE_ENV !== "production")
# the email package logs the message to the console instead of sending,
# so you can develop without a Resend account.
#
# RESEND_API_KEY    — get one at resend.com/api-keys
# RESEND_FROM_EMAIL — must be a verified sender on a domain you've added to
#                     Resend. Bare email — do NOT wrap in quotes in Vercel.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com


# -------- App URLs (used by @repo/env helpers) -------------------------------
# NEXT_PUBLIC_APP_URL — public origin of the marketing app (apps/app). Used
#   to build absolute links (password-reset emails, OAuth callbacks, etc.).
#   The dashboard's forgot-password route sends people back to the marketing
#   site's /reset-password page, so this needs to be set wherever the
#   dashboard runs too.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -------- Sentry (observability) ---------------------------------------------
# Optional. When SENTRY_DSN is set, apps/api initialises Sentry and registers
# an express error handler that captures BOTH 5xx (default) AND 4xx errors
# (override). The 4xx capture matters on auth-gated admin APIs — body-parser
# SyntaxErrors, malformed bearer tokens, etc. are real signal, not noise.
#
# SENTRY_DSN — get one at sentry.io → Settings → Projects → <project> → Client
#   Keys (DSN). Bare URL, no quotes. Absent in dev → Sentry init no-ops cleanly.
# SENTRY_ORG_SLUG — your Sentry org slug (the part after sentry.io/organizations/
#   in URLs). Used by external tooling (CLI, dashboards) when constructing
#   issue URLs.
SENTRY_DSN=
SENTRY_ORG_SLUG=


# -------- Misc legacy / template defaults ------------------------------------
NEXT_PUBLIC_PRIVATE_KEY=
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000/graphql
