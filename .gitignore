# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env.local
.env.development.local
.env.test.local
.env.production.local
# TT-1220: no real env file is ever tracked. Only .env.example is,
# and it holds placeholders. Patterns without a slash match at any depth.
.env
.env.*
!.env.example
!**/.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Bootstrap CLI — generated env files and local secrets stay off GitHub
scripts/bootstrap/output/
scripts/bootstrap/.env
scripts/bootstrap/node_modules/
